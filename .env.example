# ============================================================
# MiuMiu Rent Stuff - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=miumiu_db
MYSQL_USER=miumiu_user
MYSQL_PASSWORD=miumiu_password

# --- Backend ---
DB_HOST=mysql
DB_PORT=3306
DB_USER=miumiu_user
DB_PASSWORD=miumiu_password
DB_NAME=miumiu_db
APP_PORT=8080
GIN_MODE=debug
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost/api
